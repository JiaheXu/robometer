[Unit]
Description=Robometer-4B GPU inference API
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/robometer
ExecStart=/home/ubuntu/robometer/deployment/serve.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGINT

[Install]
WantedBy=default.target
